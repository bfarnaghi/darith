# Darith production environment template. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=darith.app,www.darith.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://darith.app,https://www.darith.app
DJANGO_TIME_ZONE=Europe/Rome
DJANGO_BEHIND_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_LOG_LEVEL=INFO

# PostgreSQL is mandatory when DEBUG is false.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=darith
DJANGO_DB_USER=darith
DJANGO_DB_PASSWORD=replace-with-a-long-random-database-password
DJANGO_DB_HOST=your-postgres-host
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=verify-full
DJANGO_DB_SSLROOTCERT=/etc/darith-postgres-ca.pem
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_CONNECT_TIMEOUT=10

# Configure a real email provider for password resets.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL="Darith <noreply@darith.app>"
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-me
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_EMAIL_USE_TLS=true

# Optional Stripe billing. Leave disabled until the Stripe checklist is complete.
DARITH_SUBSCRIPTIONS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private user uploads. Do not expose this directory directly through Nginx.
DJANGO_MEDIA_ROOT=/var/lib/darith/media

# Encrypted backup script settings.
DARITH_BACKUP_DIR=/var/backups/darith
DARITH_BACKUP_RECIPIENT=age1replace-with-your-public-recipient
